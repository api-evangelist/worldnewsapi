                  "key": "location",
                  "value": "<string>",
                  "description": "(Required) The location name to resolve, e.g. \"Tokyo, Japan\"."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "The language of the location name (ISO 6391 code)."
